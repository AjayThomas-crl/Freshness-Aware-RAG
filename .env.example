FIRECRAWL_API_KEY=
# SQLAlchemy URL (local sqlite default, swap for postgres in prod)
DATABASE_URL=sqlite:///./data/rag.db
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Seconds between scrapes for a source (default 6h). Source-level override supported.
DEFAULT_INTERVAL_SECONDS=21600
TOP_K=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Hosts scraped with the keyless HTTP scraper (comma-separated). Everything else -> Firecrawl.
LOCAL_SCRAPE_HOSTS=localhost,127.0.0.1
